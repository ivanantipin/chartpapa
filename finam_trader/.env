# Monitoring Configuration
# Divergence threshold in percent (default: 1.0)
DIVERGENCE_THRESHOLD_PERCENT=1.0

# Monitoring interval in seconds (default: 60)
MONITORING_INTERVAL_SECONDS=60

# Request Configuration
# Request timeout in seconds (default: 30)
FINAM_REQUEST_TIMEOUT=30

# Maximum retries for failed requests (default: 3)
FINAM_MAX_RETRIES=3
